#compdef zxc

_zxc() {
    local state
    local -a commands
    commands=(
        'cwd:Set default Zig version for current directory'
        'install:Install a Zig version'
        'ls:List Zig versions'
        'realpath:Print the current Zig executable'
        'rm:Delete an installed Zig version'
        "version:Prints the program's version"
        '--help:Print the help message'
    )

    _arguments \
        '1: :->command' \
        '*:: :->args'

    case $state in
        command)
            _describe 'zxc command' commands
            ;;
        args)
            case $words[1] in
                cwd)
                    _zxc_cwd
                    ;;
                i|install)
                    _arguments \
                        '--force[Overwrite the already installed version, if it exists]' \
                        '--help[Print the help message]' \
                        '1:version:' \
                        '2:path:_files -g "*.tar.xz|*.zip|*(-/)"'
                    ;;
                ls)
                    _arguments \
                        '--all[Also list versions available for download online]' \
                        '--help[Print the help message]' \
                        '--name-only[Only print version name]'
                    ;;
                rm)
                    _zxc_rm
                    ;;
            esac
            ;;
    esac
}

_zxc_cwd() {
    _arguments \
        '--help[Print the help message]' \
        '1:version:->versions'

    case $state in
        versions)
            local versions=($(zxc ls --all --name-only 2>/dev/null))
            _describe -V 'version' versions
            ;;
    esac
}

_zxc_rm() {
    _arguments \
        '--help[Print the help message]' \
        '*:version:->versions'

    case $state in
        versions)
            local all_versions=($(zxc ls --name-only 2>/dev/null))

            local selected_versions=()
            local i
            for ((i=2; i<=$#words; i++)); do
                # Skip options
                if [[ ! "$words[i]" =~ ^- ]]; then
                    selected_versions+=("$words[i]")
                fi
            done

            # Remove selected versions
            local available_versions=()
            local ver
            for ver in $all_versions; do
                if [[ ! "${selected_versions[@]}" =~ "$ver" ]]; then
                    available_versions+=("$ver")
                fi
            done

            _describe -V 'version' available_versions
            ;;
    esac
}

compdef _zxc zxc
